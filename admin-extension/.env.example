# Set these in the Directus SERVER environment, never in browser/VITE variables.
# Origin only: HTTPS in production. Django must allow this host.
UNIMIND_BACKEND_URL=https://unimind.example.com
UNIMIND_ADMIN_BRIDGE_SECRET=
# Exactly two existing Directus administrator UUIDs, comma-separated.
UNIMIND_DIRECTUS_ADMIN_IDS=
