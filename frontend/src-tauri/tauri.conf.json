{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UniMind",
  "version": "0.1.0",
  "identifier": "com.korsonedu.unimind.desktop",
  "build": {
    "frontendDist": "https://unimind-ai.com",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "UniMind",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
